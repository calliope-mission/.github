    },
    "community": {
      "bg": "lilac",
      "fg": "plum"
    },
    "data": {
      "bg": "cream",
      "fg": "olive"
    }
  },
  "contrast": {
    "cream/petrol": 14.2,
    "aqua/petrol": 12.4,
    "aqua-muted/petrol": 6.7,
    "lilac/plum": 9.6,
    "cream/plum": 14.9,
    "plum-muted/plum": 7.5,
    "olive/cream": 11.8,
    "olive-muted/cream": 5.7,
    "petrol/aqua": 12.4,
    "aqua-ink/aqua": 6.2,
    "plum/lilac": 9.6,
    "lilac-ink/lilac": 5.5
  },
  "font": {
    "sans": {
      "family": "Schibsted Grotesk",
      "weights": [
        400,
        500,
        800
      ]
    },
    "mono": {
      "family": "JetBrains Mono",
      "weights": [
        400,
        700
      ]
    }
  },
  "type": {
    "display": {
      "size": 72,
      "weight": 800,
      "lineHeight": 0.95,
      "tracking": "-0.055em"
    },
    "h1": {
      "size": 56,
      "weight": 800,
      "lineHeight": 1,
      "tracking": "-0.05em"
    },
    "h2": {
      "size": 28,
      "weight": 800,
      "lineHeight": 1.05,
      "tracking": "-0.04em"
    },
    "body": {
      "size": 17,
      "weight": 400,
      "lineHeight": 1.5
    },
    "small": {
      "size": 14,
      "weight": 400,
      "lineHeight": 1.45
