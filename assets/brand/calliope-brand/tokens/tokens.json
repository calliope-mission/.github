{
  "meta": {
    "name": "Calliope design tokens",
    "version": "1.0",
    "date": "2026-11",
    "scope": [
      "Calliope",
      "Sirenradar",
      "Unsiren",
      "Calliope community"
    ],
    "not_in_scope": [
      "Orfeo apps (style-independent)"
    ]
  },
  "color": {
    "petrol": "#10282E",
    "petrol-surface": "#1A3A41",
    "petrol-line": "#24464E",
    "aqua": "#A8F5EE",
    "aqua-muted": "#7FB5B0",
    "aqua-ink": "#2F5A5F",
    "plum": "#3B1222",
    "plum-deep": "#22080F",
    "plum-line": "#5A2A40",
    "plum-muted": "#C9A3D6",
    "lilac": "#E4B8F5",
    "lilac-ink": "#6E3550",
    "cream": "#FDF6D8",
    "cream-surface": "#F4EBC4",
    "cream-line": "#E2D6A4",
    "olive": "#3A3200",
    "olive-muted": "#6B6230"
  },
  "role": {
    "calliope": {
      "bg": "petrol",
      "fg": "cream",
      "accent": "aqua"
    },
    "sirenradar": {
      "bg": "plum",
      "fg": "lilac",
      "accent": "cream"
    },
    "unsiren": {
      "bg": "cream",
      "fg": "olive"
    },
    "orfeo": {
      "bg": "aqua",
      "fg": "petrol",
